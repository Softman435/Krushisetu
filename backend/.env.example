# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ===== Database (MySQL) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=krushisetu
DB_CONNECTION_LIMIT=10

# ===== JWT =====
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== Bcrypt =====
BCRYPT_SALT_ROUNDS=12

# ===== Razorpay =====
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ===== Platform =====
PLATFORM_FEE_PERCENT=2

# ===== Account lockout policy =====
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# ===== Default admin (used only by scripts/seedAdmin.js) =====
DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_EMAIL=admin@krushisetu.com
DEFAULT_ADMIN_PHONE=9999999999
DEFAULT_ADMIN_PASSWORD=ChangeThisNow@123
